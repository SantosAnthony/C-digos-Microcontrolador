  if (comparacaoDeValores < intervaloAgenda) {
    return;
  }
  
  ultimoTempoFormatar = tempoAtualParaFormatar;

  int cmpData = strcmp(buffer, dataHoje);

  lcd.setCursor(0,1);
  lcd.print("-Proxima  irrigacao-");

