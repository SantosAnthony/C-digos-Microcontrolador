    lcd.setCursor(12, 2); lcd.print(horaInicio);
    lcd.setCursor(0, 3);  lcd.print("Regando     ");
    conversorDeHorario();
    lcd.print(resposta);
  }
}

void verificarAgenda() {
  unsigned long tempoAtualAgenda = millis();
  if (tempoAtualAgenda - ultimoTempoAgenda < intervaloAgenda) return;
  ultimoTempoAgenda = tempoAtualAgenda;

  lerArquivo();

  if (buffer[0] != '\0' && strcmp(buffer, dataHoje) == 0) {
      if (estadoBotao == true && interfaceAtual == PROGRAMADA) return;

      if (horaInicio[0] != '\0' && strcmp(horaInicio, horaAgora) <= 0) {
        int tempoRega = atoi(duracaoStr);
        if (tempoRega > 0 && estadoAtual == OCIOSO) {
          executarRega(tempoRega);
          return;
        }
      } 
      else if (horaInicio[0] != '\0') {
        char horaCopia[9];
        strcpy(horaCopia, horaInicio);
        
        char* hora     = strtok(horaCopia,":");
        char* minutos  = strtok(NULL,":");
        char* segundos = strtok(NULL,":");

        if (hora && minutos && segundos) {
          long diffSeg = ((long)atoi(hora) * 3600L + (long)atoi(minutos) * 60L + atoi(segundos))
                       - ((long)agora.hour() * 3600L + (long)agora.minute() * 60L + agora.second());
        if (diffSeg >= 0 && diffSeg <= 2 && estadoSolenoide == DESLIGADO) {
          Serial.println("SOLENOIDE LIBERADO (pre-abertura)");
          digitalWrite(Solenoide, HIGH);
          estadoSolenoide = LIGADO;
        }
      }
    }
  }
  proximaIrrigacao();
}

void proximaIrrigacao() {
  if (interfaceAtual == PROGRAMADA){
    if (strcmp(buffer, dataHoje) < 0){
        return;
    }
    
    size_t posicao = conteudoDaLinha.find(',');
    posicao++;
    size_t posVirgulaDuracao;
    do {
      size_t posVirgulaHora = conteudoDaLinha.find(',', posicao);
      size_t tamanhoHora = posVirgulaHora - posicao; // Talvez retiravel?
      strncpy(horaInicio, conteudoDaLinha.c_str() + posicao, tamanhoHora);
      horaInicio[tamanhoHora] = '\0'; // Talvez retiravel?

      posicao = posVirgulaHora + 1;
      posVirgulaDuracao = conteudoDaLinha.find(',', posicao);
      size_t tamanhoDuracao = 4;
      strncpy(duracaoStr, conteudoDaLinha.c_str() + posicao, tamanhoDuracao);
      duracaoStr[tamanhoDuracao] = '\0'; // Terminador nulo

      if (posVirgulaDuracao != std::string::npos) {
          posicao = posVirgulaDuracao + 1;
      }
      
      if (strcmp(buffer, dataHoje) > 0) break;

    } while (posVirgulaDuracao != std::string::npos && strcmp(horaInicio, horaAgora) < 0 );


    if (horaInicio[0] == '\0' || strcmp(horaInicio, horaAgora) < 0) {
      if (estadoAtual == OCIOSO) {
        indicadorDiaTerminado = true;
      }
    }
  }
}

void executarRega(int segundos) {
  if (estadoAtual != OCIOSO) {
    return;
  }

  duracaoRega = segundos * 1000UL;

  if (estadoSolenoide == DESLIGADO){
    Serial.println("SOLENOIDE LIBERADO");
    digitalWrite(Solenoide, HIGH);
    estadoSolenoide = LIGADO;
    estadoAtual = ABRINDO_SOLENOIDE;
  } else {
    Serial.println("BOMBA LIGADA");
    digitalWrite(Bomba, HIGH);
    estadoBomba = LIGADO;
    tempoInicio = millis();
    inicioDaRega = rtc.now();
    estadoAtual = REGANDO;
  }
}

void gerenciarRega(){
  alternarBotao();

  if (interfaceAtual == MENU) return;

  // Caso tenha passado um dia
  if (strcmp(bufferParado, dataHoje) != 0 && estadoBotao == true) {
    estadoBotao = !estadoBotao;
  }
  else if (estadoBotao == 0 && estadoAtual == OCIOSO) return;
  
  unsigned long tempoAtual = millis();
  if (estadoAtual == ABRINDO_SOLENOIDE) {
    if (estadoBotao) {
      estadoAtual = ESPERANDO_SOLENOIDE;
      tempoInicio = tempoAtual;
      return;
    }
    if (tempoAtual - tempoInicio >= atrasoSolenoide) {
      Serial.println("BOMBA LIGADA");
      digitalWrite(Bomba, HIGH);
      estadoBomba = LIGADO;
      tempoInicio = tempoAtual;
      estadoAtual = REGANDO;
    }
  }
  else if (estadoAtual == REGANDO) {
    if (tempoAtual - tempoInicio >= duracaoRega || estadoBotao == true) {
      digitalWrite(Bomba, LOW);
      Serial.println("BOMBA DESLIGADA");
  
      registrarLogRegaConcluida();

      tempoInicio = tempoAtual;
      estadoBomba = DESLIGADO;
      estadoAtual = ESPERANDO_SOLENOIDE;
    }
  }
  else if (estadoAtual == ESPERANDO_SOLENOIDE) {
    if (tempoAtual - tempoInicio >= atrasoSolenoide) {
      if(estadoBomba == DESLIGADO){
        digitalWrite(Solenoide, LOW);
        Serial.println("SOLENOIDE FECHADO");
        estadoSolenoide = DESLIGADO;
      }
      estadoAtual = OCIOSO;
      if (interfaceAtual == IRRIGACAO_FORCADA && regaForcadaAtiva) {atualizarProximaIrrigacaoForcada(); }
      strcpy(ultimoBuffer, "1900/01/01");
    }
  }
}

void registrarLogRegaConcluida() {
  DateTime fimDaRega = rtc.now();
  
  TimeSpan duracaoReal = fimDaRega - inicioDaRega;

  File logFile = SD.open("/logdata.txt", FILE_WRITE);
  if (logFile) {
    char linhaLog[100];
    
    sprintf(linhaLog, "%04d/%02d/%02d, Inicio: %02d:%02d:%02d, Fim: %02d:%02d:%02d, Duracao: %ld seg\n", 
            inicioDaRega.year(), inicioDaRega.month(), inicioDaRega.day(),
            inicioDaRega.hour(), inicioDaRega.minute(), inicioDaRega.second(),
            fimDaRega.hour(), fimDaRega.minute(), fimDaRega.second(),
            duracaoReal.totalseconds());
            
    logFile.print(linhaLog);
    logFile.close();
    
    Serial.print("Log registrado: ");
    Serial.print(linhaLog);
  } else {
    Serial.println("ERRO: Falha ao abrir /logdata.txt para salvar o log.");
  }
}

void lerArquivo(){
  if (interfaceAtual != PROGRAMADA) return;

  if (estadoDeLeitura == false){
    if ((strcmp(buffer, dataHoje) > 0) ||
       (strcmp(buffer, dataHoje) == 0 && indicadorDiaTerminado == false)){
      return;
    }
  } else {
    estadoDeLeitura = false;
  }


  if (!SD.exists("/data.txt")) {
    f = SD.open("/data.txt", FILE_WRITE);
    if (f) {
      f.print(linhaCodigo);
      f.close();
    } else {
      Serial.println("Erro ao criar data.txt");
    }
  }
    
  f = SD.open("/data.txt");
  if(f) {
    digitalWrite(33, HIGH);
    while (f.available()) { 
      conteudoDaLinha = f.readStringUntil('\n').c_str();
      
      String primeiroDado;
      if (conteudoDaLinha.length() > 0) {
        int indiceVirgula = conteudoDaLinha.find(',');
        primeiroDado = conteudoDaLinha.substr(0, indiceVirgula).c_str();
      }

      strncpy(buffer, primeiroDado.c_str(), sizeof(buffer) - 1);
      buffer[sizeof(buffer) - 1] = '\0';
      
      if (indicadorDiaTerminado == true) {
          indicadorDiaTerminado = false;
          continue;
        }
      
      if (strcmp(buffer, dataHoje) == 0 && indicadorDiaTerminado == false) break;
      if (strcmp(buffer, dataHoje) > 0) break;
    }
    digitalWrite(33, LOW);
    f.close();
  } else {
    Serial.println("Erro ao abrir data.txt");
  }
}

