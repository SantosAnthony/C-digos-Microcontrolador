void executarIrrigacaoForcada() {
  lcd.clear();
  Serial.println("SOLENOIDE LIBERADO");
  digitalWrite(Solenoide, HIGH); 
  estadoSolenoide = LIGADO;
  delay(atrasoSolenoide);

  int duracaoEmSegundos = duracaoRegaForcado * 60;
  executarRega(duracaoEmSegundos);

  agora = rtc.now();
  if (horaRegaForcado != 0) {

  regaForcadaAtiva = true;
  ultimoTempoRegaForcada = agora.unixtime();

  Serial.print("Irrigacao forcada iniciada! Duracao: ");
  Serial.print(duracaoRegaForcado);
  Serial.print(" min | Repeticao a cada: ");
  Serial.print(horaRegaForcado);
  Serial.println(" h");
  }
}

void verificarRegaForcada() {
  if (!regaForcadaAtiva) {
    return; 
  }

  agora = rtc.now();
  uint32_t tempoAtual = agora.unixtime();
  uint32_t intervaloEmSegundos = horaRegaForcado * 3600UL;

  if ((tempoAtual - ultimoTempoRegaForcada) >= intervaloEmSegundos) {
    ultimoTempoRegaForcada = tempoAtual;
    executarIrrigacaoForcada();
  }
}
