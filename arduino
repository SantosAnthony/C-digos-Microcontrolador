void atualizarAgenda() {
  unsigned long tempoAtualAtualizarAgenda = millis();
  
  if (tempoAtualAtualizarAgenda - tempoAnteriorAtualizarAgenda < intervaloAtualizarAgenda) {
    return;
  }
  tempoAnteriorAtualizarAgenda = tempoAtualAtualizarAgenda;

  agora = rtc.now();
  sprintf(dataHoje, "%04d/%02d/%02d", agora.year(), agora.month(), agora.day());
  sprintf(horaAgora, "%02d:%02d:%02d", agora.hour(), agora.minute(), agora.second());

  if (interfaceAtual == MENU || voltarParaProgramada) return;
  lcd.setCursor(0, 0);
  lcd.print(dataHoje);
  lcd.setCursor(12, 0);
  lcd.print(horaAgora);
}

void conversorDeHorario(){
  int horas, minutos, segundos;
  int horaIrrigacao, minutoIrrigacao, segundoIrrigacao;
  
  int valorDuracaoStr = atoi(duracaoStr), tamanhoDuracaoStr = strlen(duracaoStr);

  sscanf(horaInicio,"%d:%d:%d", &horaIrrigacao, &minutoIrrigacao, &segundoIrrigacao);

  int totalSegundos = (valorDuracaoStr) + (horaIrrigacao * 3600L + minutoIrrigacao * 60 + segundoIrrigacao);

  minutos = (totalSegundos % 3600) / 60;
  segundos = totalSegundos % 60;
  horas = (totalSegundos / 3600) % 24;

  sprintf(resposta, "%02d:%02d:%02d", horas, minutos, segundos);

  return;
}

void formatarLcd() {
