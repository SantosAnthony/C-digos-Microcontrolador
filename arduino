void executarRega(int segundos) {
  if (estadoAtual != OCIOSO) {
    return;
  }

  if (estadoSolenoide == DESLIGADO){
    Serial.println("SOLENOIDE LIBERADO");
    digitalWrite(Solenoide, HIGH);
    estadoSolenoide = LIGADO;
  }

  Serial.println("BOMBA LIGADA");
  digitalWrite(Bomba, HIGH);
  estadoBomba = LIGADO;

  tempoInicio = millis();
  duracaoRega = segundos * 1000UL;
  estadoAtual = REGANDO;
}

void gerenciarRega(){
  switchBotao();
  formatarLcd();

  if (menuAtivo == true) return;

  if (estadoBotao == 1) {
    lcd.setCursor(0,3);
    lcd.print("REGA DIA OFF");
    return;
  }
  
  unsigned long tempoAtual = millis();
  if (estadoAtual == REGANDO) {
    if (tempoAtual - tempoInicio >= duracaoRega) {
      digitalWrite(Bomba, LOW);
      Serial.println("BOMBA DESLIGADA");
  
      tempoInicio = tempoAtual;
      estadoBomba = DESLIGADO;
      estadoAtual = ESPERANDO_SOLENOIDE;
    }
  }
  else if (estadoAtual == ESPERANDO_SOLENOIDE) {
    if (tempoAtual - tempoInicio >= atrasoSolenoide) {
      if(estadoBomba == DESLIGADO){
        digitalWrite(Solenoide, LOW);
        Serial.println("SOLENOIDE FECHADO");
        estadoSolenoide = DESLIGADO;
      }
      estadoAtual = OCIOSO;
    }
  }
}

void lerArquivo(){
  if (menuAtivo == true) return;

  if((strcmp(buffer, dataHoje) > 0) || (strcmp(buffer, dataHoje) == 0 && indicadorDiaTerminado == false)){
    return;
  }

  if (!SD.exists("/data.txt")) {
    f = SD.open("/data.txt", FILE_WRITE);
    if (f) {
      f.print(linhaCodigo);
      f.close();
    } else {
      Serial.println("Erro ao criar data.txt");
    }
  }

  f = SD.open("/data.txt");
  if(f) {
    digitalWrite(33, HIGH);
    while (f.available()) { 
      conteudoDaLinha = f.readStringUntil('\n').c_str();
      
      String primeiroDado;
      if (conteudoDaLinha.length() > 0) {
        int indiceVirgula = conteudoDaLinha.find(',');
        primeiroDado = conteudoDaLinha.substr(0, indiceVirgula).c_str();
      }

      strncpy(buffer, primeiroDado.c_str(), sizeof(buffer) - 1);
      buffer[sizeof(buffer) - 1] = '\0';
      
      if (indicadorDiaTerminado == true) {
          indicadorDiaTerminado = false;
          continue;
        }
      if (strcmp(buffer, dataHoje) == 0 && indicadorDiaTerminado == false) {
        break;
      } 

      if (strcmp(buffer, dataHoje) > 0){
        break; 
      }
    }
    digitalWrite(33, LOW);
    f.close();
  } else {
    Serial.println("Erro ao abrir data.txt");
  }
}

